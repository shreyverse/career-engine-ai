# ==========================================
# CAREER ENGINE — ENVIRONMENT CONFIGURATION
# ==========================================

# ------------------------------------------
# BACKEND CONFIGURATION
# ------------------------------------------
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:3000

# Database Connection (PostgreSQL)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/career_engine?schema=public"

# Authentication Secrets (Phase 2+)
JWT_SECRET=your_jwt_secret_min_32_characters_here
JWT_EXPIRES_IN=7d
REFRESH_TOKEN_SECRET=your_refresh_token_secret_here
REFRESH_TOKEN_EXPIRES_IN=30d

# OAuth Provider Credentials (Phase 2+)
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_CALLBACK_URL=http://localhost:5000/api/auth/google/callback

# AI & Gemini API (Phase 3+)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-pro

# File Storage / S3 / Cloudinary (Phase 4+)
STORAGE_BUCKET_NAME=career-engine-resumes
STORAGE_REGION=us-east-1
STORAGE_ACCESS_KEY=your_storage_access_key
STORAGE_SECRET_KEY=your_storage_secret_key

# ------------------------------------------
# FRONTEND CONFIGURATION (Vite safe prefix: VITE_)
# ------------------------------------------
VITE_API_URL=http://localhost:5000/api
VITE_APP_NAME="Career Engine"
VITE_APP_DESCRIPTION="AI-Powered Career Intelligence Platform"
